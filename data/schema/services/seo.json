      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does it cost to implement an SEO campaign for my business?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cost depends on scope rather than a fixed package: the size and condition of your website, how competitive your keywords are, how many locations or markets you target, and how much content and link building is required. Most SEO campaigns run as a monthly retainer after an initial audit. We provide a scoped proposal once we have reviewed your site and goals."
          }
        },
        {
          "@type": "Question",
          "name": "How long does SEO take before we see meaningful results?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Technical fixes can register within weeks of Google recrawling your pages, but competitive rankings and lead growth build more slowly; Google's own guidance suggests most SEO work needs four months to a year to show its full effect. Timing depends on domain history, competition and implementation speed, so we track milestone KPIs that show progress along the way."
          }
        },
        {
          "@type": "Question",
          "name": "Does AI SEO replace traditional SEO services, or do we need both?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You need both, because they share the same foundations. AI assistants and Google AI Overviews draw heavily on content that is crawlable, well structured and trusted, which is exactly what traditional organic SEO builds. AI SEO adds specific work on top: answer-first formatting, entity clarity, brand mentions on third-party sites and monitoring how ChatGPT, Claude and other platforms describe your business."
          }
        }
      ]
